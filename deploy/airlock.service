[Unit]
Description=Airlock — sandboxed data-analysis agent
After=network-online.target docker.service
Wants=docker.service

[Service]
User=airlock
EnvironmentFile=/opt/airlock/airlock.env
WorkingDirectory=/opt/airlock/backend
ExecStart=/opt/airlock/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
